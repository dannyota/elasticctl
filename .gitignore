# Rust
/target/
**/*.rs.bk
*.pdb

# Secrets and credentials; never commit them.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
credentials.json
# Ignore the local `/config.toml` at the repository root. The committed
# `.cargo/config.toml` holds the `xtask` alias and remains tracked.
/config.toml
.elasticctl/

# Recorded fixtures may contain live credentials until scrubbed.
tests/fixtures/**/*.unscrubbed.json

# Local lab state
lab/data/
lab/certs/
lab/.env

# Tooling
.mcp.json
.playwright-profile/
.playwright-mcp/
.worktrees/

# Local working notes
PLAN.md
scratch/

# Fetched sample corpora; the harness downloads them on demand.
samples/out/

