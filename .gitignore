# `xtask` alias.
/config.toml
.elasticctl/

# Recorded fixtures may contain live credentials until scrubbed.
tests/fixtures/**/*.unscrubbed.json

# Local lab state
lab/data/
lab/certs/
lab/.env

# Tooling
.mcp.json
.playwright-profile/
.playwright-mcp/

# Local working notes
PLAN.md
scratch/

# Fetched sample corpora; the harness downloads them on demand.
samples/out/

