  \"required\": false,\n              \"takes_value\": true,\n              \"help\": \"Rule ids or names to apply. Omit with no --tag/--search to use --source\"\n            },\n            {\n              \"name\": \"dir\",\n              \"required\": true,\n              \"takes_value\": false,\n              \"help\": null\n            },\n            {\n              \"name\": \"report\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Write a change-evidence report\"\n            },\n            {\n              \"name\": \"tag\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Apply every rule carrying this tag, in addition to any selectors\"\n            },\n            {\n              \"name\": \"search\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Apply every rule whose name contains this text or carries it as a tag\"\n            },\n            {\n              \"name\": \"source\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Source scope used when selectors, --tag, and --search are absent\"\n            }\n          ],\n          \"subcommands\": []\n        }\n      ]\n    },\n    {\n      \"name\": \"search\",\n      \"about\": \"Run ES|QL or Query DSL against Elasticsearch data\",\n      \"mutates\": false,\n      \"args\": [],\n      \"subcommands\": [\n        {\n          \"name\": \"esql\",\n          \"about\": \"Run an ES|QL query\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"query\",\n              \"required\": true,\n              \"takes_value\": false,\n              \"help\": \"The ES|QL query text\"\n            },\n            {\n              \"name\": \"data_view\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Resolve a Kibana data view to an index pattern\"\n            },\n            {\n              \"name\": \"index\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Explicit index or alias, overrides the query's own source\"\n            },\n            {\n              \"name\": \"limit\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Cap the number of result rows\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"dsl\",\n          \"about\": \"Run a Query DSL search body\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"body\",\n              \"required\": true,\n              \"takes_value\": false,\n              \"help\": \"JSON body or @path\"\n            },\n            {\n              \"name\": \"data_view\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Resolve a Kibana data view to an index pattern\"\n            },\n            {\n              \"name\": \"index\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Explicit index or alias\"\n            },\n            {\n              \"name\": \"limit\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Cap the number of result rows\"\n            },\n            {\n              \"name\": \"with_meta\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Add `_id`, `_index`, and `_score` to each rendered row\"\n            }\n          ],\n          \"subcommands\": []\n        }\n      ]\n    },\n    {\n      \"name\": \"alerts\",\n      \"about\": \"Triage detection alerts\",\n      \"mutates\": false,\n      \"args\": [],\n      \"subcommands\": [\n        {\n          \"name\": \"list\",\n          \"about\": \"List detection alerts\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"status\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Filter by workflow status\"\n            },\n            {\n              \"name\": \"severity\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Filter by severity\"\n            },\n            {\n              \"name\": \"rule\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Filter by rule name or rule_id\"\n            },\n            {\n              \"name\": \"tag\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Filter by workflow tag\"\n            },\n            {\n              \"name\": \"assignee\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Filter by assignee username, or uid:<profile_uid>\"\n            },\n            {\n              \"name\": \"since\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Only alerts newer than a duration (90m, 24h, 7d) or an ISO timestamp\"\n            },\n            {\n              \"name\": \"search\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Substring match on the rule name and reason text\"\n            },\n            {\n              \"name\": \"limit\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Cap the rows returned (peek default: 100; --out is uncapped)\"\n            },\n            {\n              \"name\": \"with_meta\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Merge _id into each alert document\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"get\",\n          \"about\": \"Show one alert by document id\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"alert_id\",\n              \"required\": true,\n              \"takes_value\": false,\n              \"help\": \"The alert document _id\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"ack\",\n          \"about\": \"Acknowledge alerts, by id or by query\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"alert_ids\",\n              \"required\": false,\n              \"takes_value\": true,\n              \"help\": \"Alert document ids\"\n            },\n            {\n              \"name\": \"query\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Query DSL selecting the alerts: inline JSON or @file\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"open\",\n          \"about\": \"Reopen alerts, by id or by query\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"alert_ids\",\n              \"required\": false,\n              \"takes_value\": true,\n              \"help\": \"Alert document ids\"\n            },\n            {\n              \"name\": \"query\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Query DSL selecting the alerts: inline JSON or @file\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"close\",\n          \"about\": \"Close alerts, by id or by query\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"alert_ids\",\n              \"required\": false,\n              \"takes_value\": true,\n              \"help\": \"Alert document ids\"\n            },\n            {\n              \"name\": \"query\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Query DSL selecting the alerts: inline JSON or @file\"\n            },\n            {\n              \"name\": \"reason\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Close reason recorded on each alert\"\n            },\n            {\n              \"name\": \"conflicts\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"On a version conflict: abort (default) or proceed\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"tag\",\n          \"about\": \"Add or remove workflow tags on alerts\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"alert_ids\",\n              \"required\": true,\n              \"takes_value\": true,\n              \"help\": \"Alert document ids\"\n            },\n            {\n              \"name\": \"add\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Tag to add (repeatable)\"\n            },\n            {\n              \"name\": \"remove\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Tag to remove (repeatable)\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"assign\",\n          \"about\": \"Assign or unassign users on alerts\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"alert_ids\",\n              \"required\": true,\n              \"takes_value\": true,\n              \"help\": \"Alert document ids\"\n            },\n            {\n              \"name\": \"add\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Username or uid:<profile_uid> to assign (repeatable)\"\n            },\n            {\n              \"name\": \"remove\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Username or uid:<profile_uid> to unassign (repeatable)\"\n            }\n          ],\n          \"subcommands\": []\n        }\n      ]\n    },\n    {\n      \"name\": \"cases\",\n      \"about\": \"Track investigations as cases\",\n      \"mutates\": false,\n      \"args\": [],\n      \"subcommands\": [\n        {\n          \"name\": \"list\",\n          \"about\": \"List cases\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"status\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Filter by status\"\n            },\n            {\n              \"name\": \"severity\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Filter by severity\"\n            },\n            {\n              \"name\": \"tag\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Filter by tag\"\n            },\n            {\n              \"name\": \"search\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Substring match on title and description\"\n            },\n            {\n              \"name\": \"limit\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Cap the rows returned (peek default: 100; --out is uncapped)\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"get\",\n          \"about\": \"Show one case in full\",\n          \"mutates\": false,\n          \"args\": [\n           