    "code": 0,
    "stdout": "{\n  \"name\": \"elasticctl\",\n  \"version\": \"VERSION\",\n  \"global_args\": [\n    {\n      \"name\": \"profile\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Use a named profile\"\n    },\n    {\n      \"name\": \"config\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Use a specific configuration file\"\n    },\n    {\n      \"name\": \"space\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Kibana space to operate in\"\n    },\n    {\n      \"name\": \"json\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Force JSON output\"\n    },\n    {\n      \"name\": \"format\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Output format: table, json, yaml, csv, jsonl\"\n    },\n    {\n      \"name\": \"fields\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Comma-separated fields to include\"\n    },\n    {\n      \"name\": \"out\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Write output to a file instead of stdout\"\n    },\n    {\n      \"name\": \"yes\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Apply a mutation after reviewing its preview\"\n    },\n    {\n      \"name\": \"timeout\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Request timeout in seconds\"\n    },\n    {\n      \"name\": \"debug\",\n      \"required\": false,\n      \"takes_value\": false,\n      \"help\": \"Log HTTP requests and responses, with secrets redacted\"\n    }\n  ],\n  \"commands\": [\n    {\n      \"name\": \"config\",\n      \"about\": \"Manage connection profiles\",\n      \"mutates\": false,\n      \"args\": [],\n      \"subcommands\": [\n        {\n          \"name\": \"init\",\n          \"about\": \"Create or replace a profile\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"name\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Profile name; defaults to \\\"default\\\"\"\n            },\n            {\n              \"name\": \"from_env\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Take values from ELASTICCTL_* environment variables\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"list\",\n          \"about\": \"List configured profiles\",\n          \"mutates\": false,\n          \"args\": [],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"show\",\n          \"about\": \"Show one profile, with secrets redacted\",\n          \"mutates\": false,\n          \"args\": [],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"test\",\n          \"about\": \"Verify the profile can reach and authenticate to the stack\",\n          \"mutates\": false,\n          \"args\": [],\n          \"subcommands\": []\n        }\n      ]\n    },\n    {\n      \"name\": \"doctor\",\n      \"about\": \"Check connectivity, authentication, key scope, and rule access\",\n      \"mutates\": false,\n      \"args\": [],\n      \"subcommands\": []\n    },\n    {\n      \"name\": \"info\",\n      \"about\": \"Show stack version, flavor, license tier, and spaces\",\n      \"mutates\": false,\n      \"args\": [],\n      \"subcommands\": []\n    },\n    {\n      \"name\": \"rules\",\n      \"about\": \"Manage detection rules\",\n      \"mutates\": false,\n      \"args\": [],\n      \"subcommands\": [\n        {\n          \"name\": \"list\",\n          \"about\": \"List detection rules\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"enabled\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": null\n            },\n            {\n              \"name\": \"disabled\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": null\n            },\n            {\n              \"name\": \"rule_type\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": null\n            },\n            {\n              \"name\": \"severity\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": null\n            },\n            {\n              \"name\": \"tag\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": null\n            },\n            {\n              \"name\": \"filter\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Raw KQL, combined with the other filters\"\n            },\n            {\n              \"name\": \"search\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Friendly name-substring + tag search, mutually exclusive with --filter\"\n            },\n            {\n              \"name\": \"source\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Which rules to list: custom, customized, prebuilt, or all\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"get\",\n          \"about\": \"Show one rule by rule_id or name. rule_id is tried first: if the selector happens to be both a valid rule_id and a different rule's name, the rule_id match wins\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"selector\",\n              \"required\": true,\n              \"takes_value\": false,\n              \"help\": null\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"validate\",\n          \"about\": \"Check a rule file without contacting a server\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"path\",\n              \"required\": true,\n              \"takes_value\": false,\n              \"help\": null\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"enable\",\n          \"about\": \"Enable one or more rules\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"selectors\",\n              \"required\": false,\n              \"takes_value\": true,\n              \"help\": null\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"disable\",\n          \"about\": \"Disable one or more rules\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"selectors\",\n              \"required\": false,\n              \"takes_value\": true,\n              \"help\": null\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"delete\",\n          \"about\": \"Delete one or more rules\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"selectors\",\n              \"required\": false,\n              \"takes_value\": true,\n              \"help\": null\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"export\",\n          \"about\": \"Export rules to a file or stdout. Exports every rule unless selectors or --tag narrow it\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"selectors\",\n              \"required\": false,\n              \"takes_value\": true,\n              \"help\": \"Rule ids or names to export. Omit to export every rule\"\n            },\n            {\n              \"name\": \"tag\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Export every rule carrying this tag, in addition to any selectors\"\n            },\n            {\n              \"name\": \"format_file\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"File format: ndjson or yaml. Distinct from the global --format, which renders this command's own report, not the exported file\"\n            },\n            {\n              \"name\": \"source\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Which rules to export: custom, customized, prebuilt, or all\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"import\",\n          \"about\": \"Import rules from a file\",\n          \"mutates\": true,\n          \"args\": [\n            {\n              \"name\": \"path\",\n              \"required\": true,\n              \"takes_value\": false,\n              \"help\": null\n            },\n            {\n              \"name\": \"overwrite\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Replace rules that already exist\"\n            },\n            {\n              \"name\": \"skip_existing\",\n              \"required\": false,\n              \"takes_value\": false,\n              \"help\": \"Leave rules that already exist alone instead of failing on them\"\n            }\n          ],\n          \"subcommands\": []\n        },\n        {\n          \"name\": \"preview\",\n          \"about\": \"Run a rule against history without writing alerts\",\n          \"mutates\": false,\n          \"args\": [\n            {\n              \"name\": \"source\",\n              \"required\": true,\n              \"takes_value\": false,\n              \"help\": \"A file path, rule_id, or rule name\"\n            },\n           