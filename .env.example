# Copy to .env, chmod 0600, and fill in the values. .env is gitignored; this
# file is not. Keep real URLs, deployment IDs, account data, and credentials
# out of this file.
#
# Three key types exist and they are not interchangeable. All carry the essu_
# prefix, so the prefix identifies nothing; only the realm does.
#
#   Project-scoped Elasticsearch API key (realm _es_api_key)
#     Create it inside Kibana: Project Settings > Management > API keys on
#     Serverless, Stack Management > API keys on Hosted.
#     Required to enable a rule, apply a disable, or run state push.
#     elasticctl uses only this key type.
#
#   Organization-level Cloud API key (realm _cloud_api_key)
#     Created in the Elastic Cloud console. It can read rules and create
#     disabled ones, but enabling a rule fails: the alerting framework refuses
#     to mint a rule API key on its behalf.
#
#   Cloud API key with provisioning rights
#     Created in the Cloud console under Organization > API keys. Use it only
#     against api.elastic-cloud.com to create, resume, or delete projects and
#     deployments.
#
# Check which realm a key authenticates through with either:
#   elasticctl doctor
#   curl -H "Authorization: ApiKey $ELASTICCTL_API_KEY" \
#        "$ELASTICCTL_ES_URL/_security/_authenticate"

# Primary target: the Serverless Security project. The CLI, the live suite,
# fixture recording, and conformance all read these generic names.
ELASTICCTL_KIBANA_URL=https://YOUR-PROJECT-ID.kb.YOUR-REGION.aws.elastic.cloud
ELASTICCTL_ES_URL=https://YOUR-PROJECT-ID.es.YOUR-REGION.aws.elastic.cloud
ELASTICCTL_API_KEY=REPLACE_ME
ELASTICCTL_SPACE=default

# Optional request timeout in seconds. The default is 30.
#ELASTICCTL_TIMEOUT=30

# Fixture recording only. Names the fixture directory:
# serverless | ech | traditional.
ELASTICCTL_FIXTURE_FLAVOR=serverless

# Fixture recording only. `cargo xtask record` scrubs this host from fixtures;
# nothing sends requests to it.
ELASTICCTL_INGEST_URL=https://YOUR-PROJECT-ID.ingest.YOUR-REGION.aws.elastic.cloud

# Optional second target: an Elastic Cloud Hosted deployment.
# `cargo xtask conformance-matrix` reads these names directly for its ech leg.
# The CLI and `cargo xtask record` read only the generic names, so map them by
# hand to record Hosted fixtures:
#   ELASTICCTL_KIBANA_URL="$ELASTICCTL_ECH_KIBANA_URL" \
#   ELASTICCTL_ES_URL="$ELASTICCTL_ECH_ES_URL" \
#   ELASTICCTL_API_KEY="$ELASTICCTL_ECH_API_KEY" \
#   ELASTICCTL_FIXTURE_FLAVOR=ech cargo xtask record
#ELASTICCTL_ECH_KIBANA_URL=https://YOUR-DEPLOYMENT.kb.YOUR-REGION.aws.elastic-cloud.com
#ELASTICCTL_ECH_ES_URL=https://YOUR-DEPLOYMENT.es.YOUR-REGION.aws.elastic-cloud.com
#ELASTICCTL_ECH_API_KEY=REPLACE_ME
#ELASTICCTL_ECH_SPACE=default

# Optional. When both are set, the conformance matrix logs this user in once to
# activate a Kibana profile, which the triage contract needs to assign alerts.
# Without them it relies on a profile from an earlier console login.
#ELASTICCTL_ECH_USERNAME=
#ELASTICCTL_ECH_PASSWORD=

# Optional Cloud API key for api.elastic-cloud.com, for resuming or
# provisioning projects by hand. No elasticctl command or xtask reads it.
#ELASTICCTL_CLOUD_API_KEY=

# Set these per command instead of storing them here:
#   ELASTICCTL_LIVE=1        runs the ignored live test suite
#   ELASTICCTL_USERNAME, ELASTICCTL_PASSWORD
#                            traditional (lab) fixture recording only
#   ELASTICCTL_RECORD_TRACE=1
#                            prints recorder step labels
# lab/up.sh prints a disposable self-managed key. Pass it only to the process
# that needs it.
