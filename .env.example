# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Two key types exist and they are NOT interchangeable:
#
#   Project-scoped Elasticsearch API key  (realm _es_api_key)
#     Created INSIDE Kibana: Project Settings > Management > API keys.
#     Required for anything that enables or schedules a rule.
#     This is the one elasticctl uses.
#
#   Organization-level Cloud API key      (realm _cloud_api_key)
#     Created in the Elastic Cloud console.
#     Reads fine and can create DISABLED rules, but enabling a rule fails:
#     the alerting framework refuses to mint a rule API key on its behalf.
#     Only useful for control-plane calls against api.elastic-cloud.com.
#
# The essu_ prefix appears on both. Check the realm with:
#   curl -H "Authorization: ApiKey $ELASTICCTL_API_KEY" \
#        "$ELASTICCTL_ES_URL/_security/_authenticate"
# or just run: elasticctl doctor

# serverless | ech | self-managed
ELASTICCTL_FLAVOR=serverless

ELASTICCTL_KIBANA_URL=https://YOUR-PROJECT-ID.kb.YOUR-REGION.aws.elastic.cloud
ELASTICCTL_ES_URL=https://YOUR-PROJECT-ID.es.YOUR-REGION.aws.elastic.cloud
ELASTICCTL_INGEST_URL=https://YOUR-PROJECT-ID.ingest.YOUR-REGION.aws.elastic.cloud

ELASTICCTL_SPACE=default

# Project-scoped Elasticsearch API key. Used for every rule operation.
ELASTICCTL_API_KEY=REPLACE_ME

# Optional. Organization-level Cloud key, for control-plane calls only.
# Leave unset unless you need it.
#ELASTICCTL_ORG_API_KEY=
