# Copy to .env and fill in the values. .env is gitignored; this file is not.
# Keep real URLs, deployment IDs, account data, and credentials out of this file.
#
# These three key types are not interchangeable:
#
#   Project-scoped Elasticsearch API key (realm _es_api_key, essu_ prefix)
#     Create it in Kibana: Project Settings > Management > API keys.
#     Required for anything that enables or schedules a rule.
#     elasticctl uses this key.
#
#   Organization-level Cloud API key (realm _cloud_api_key, essu_ prefix)
#     Created in the Elastic Cloud console.
#     It can read and create disabled rules, but enabling a rule fails:
#     the alerting framework refuses to mint a rule API key on its behalf.
#     Use it only for control-plane calls against api.elastic-cloud.com.
#
#   Organization API key with provisioning rights
#     Created in the Cloud console under Organization > API keys.
#     Use it only to create and destroy deployments and projects.
#
# All three keys use the essu_ prefix. Check the realm with:
#   curl -H "Authorization: ApiKey $ELASTICCTL_API_KEY" \
#        "$ELASTICCTL_ES_URL/_security/_authenticate"
# Or run: elasticctl doctor

# Fixture directory label: serverless | ech | traditional
ELASTICCTL_FIXTURE_FLAVOR=serverless

ELASTICCTL_KIBANA_URL=https://YOUR-PROJECT-ID.kb.YOUR-REGION.aws.elastic.cloud
ELASTICCTL_ES_URL=https://YOUR-PROJECT-ID.es.YOUR-REGION.aws.elastic.cloud
ELASTICCTL_INGEST_URL=https://YOUR-PROJECT-ID.ingest.YOUR-REGION.aws.elastic.cloud

ELASTICCTL_SPACE=default

# Project-scoped Elasticsearch API key. Used for stack API operations.
ELASTICCTL_API_KEY=REPLACE_ME

# Optional organization-level Cloud key for manual control-plane calls.
# The CLI and xtask do not read it.
# Leave it unset unless needed.
#ELASTICCTL_ORG_API_KEY=

# Optional Cloud control-plane key for api.elastic-cloud.com.
# The CLI and xtask do not read it.
#ELASTICCTL_CLOUD_API_KEY=

# Optional second Elastic Cloud Hosted target. These names let one .env keep
# both targets, but the CLI and xtask do not read the ECH-prefixed names
# directly. Map them to the generic names when recording Hosted fixtures.
#ELASTICCTL_ECH_KIBANA_URL=https://YOUR-DEPLOYMENT.kb.YOUR-REGION.aws.elastic-cloud.com
#ELASTICCTL_ECH_ES_URL=https://YOUR-DEPLOYMENT.es.YOUR-REGION.aws.elastic-cloud.com
#ELASTICCTL_ECH_API_KEY=REPLACE_ME

# Fixture recording uses ELASTICCTL_KIBANA_URL, ELASTICCTL_ES_URL,
# ELASTICCTL_INGEST_URL, ELASTICCTL_API_KEY, ELASTICCTL_SPACE, and
# ELASTICCTL_FIXTURE_FLAVOR. To record the optional Hosted target:
#   ELASTICCTL_KIBANA_URL="$ELASTICCTL_ECH_KIBANA_URL" \
#   ELASTICCTL_ES_URL="$ELASTICCTL_ECH_ES_URL" \
#   ELASTICCTL_API_KEY="$ELASTICCTL_ECH_API_KEY" \
#   ELASTICCTL_FIXTURE_FLAVOR=ech cargo xtask record
